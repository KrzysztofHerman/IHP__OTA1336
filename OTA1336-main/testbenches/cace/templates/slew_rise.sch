C {OTA1336.sym} 1520 -1040 0 0 {name=x1}
C {isource.sym} 940 -650 0 0 {name=Ibias value="DC CACE\{Ibias\}"}
C {devices/code_shown.sym} 50 -1650 0 0 {name=SETUP only_toplevel=false value="* CACE gensim simulation file CACE\{filename\}_CACE\{N\}
* Generated by CACE gensim, Efabless Corporation (c) 2023
* Find the current through the amplifier under condition of static input

.include CACE\{DUT_path\}

.lib cornerMOSlv.lib CACE\{corner\}
.lib cornerCAP.lib cap_typ

.option TEMP=CACE\{temperature\}
* Flag unsafe operating conditions (exceeds models' specified limits)
.option warn=1
"}
C {title-3.sym} 0 0 0 0 {name=l2 author="IHP-GmbH 2026" title="CACE template dynamic currect consumption" rev=1.0 lock=true}
C {devices/vsource.sym} 830 -740 0 0 {name=VVdiff1 value="DC 0 PWL(0 0 100n 0 100.1n CACE\{Vvdd\})" savecurrent=false}
C {devices/lab_pin.sym} 690 -620 0 0 {name=p4 sig_type=std_logic lab=VSUB}
C {devices/vsource.sym} 1160 -650 0 0 {name=Vvss1 value="DC CACE\{Vvss\}" savecurrent=false}
C {devices/lab_wire.sym} 1310 -1170 0 1 {name=p5 sig_type=std_logic lab=vdd}
C {devices/lab_wire.sym} 1310 -910 0 1 {name=p6 sig_type=std_logic lab=vss}
C {devices/lab_wire.sym} 2000 -1040 0 0 {name=p7 sig_type=std_logic lab=out}
C {devices/lab_pin.sym} 940 -920 0 1 {name=p29 sig_type=std_logic lab=ena}
C {devices/vsource.sym} 710 -650 0 0 {name=Vvdd1 value="DC CACE\{Vvdd\}" savecurrent=false}
C {devices/code_shown.sym} 50 -1350 0 0 {name=CONTROL1 only_toplevel=false value=".control
* Step function applied at time 100ns, measure slew from transient data
tran 100n 10u
meas tran tlow when V(out)=0.5 CROSS=LAST
meas tran thigh when V(out)= CACE[CACE\{Vvdd\} - 0.5] CROSS=LAST
let vres = 2.0 / ($&thigh - $&tlow)
* vres2 is full-power bandwidth (fpbw)
let vres2 = $&vres / (3.1415926 * CACE\{Vvdd\})

set wr_singlescale
echo $&vres $&vres2 > CACE\{simpath\}/CACE\{filename\}_CACE\{N\}.data
quit
.endc
"}
C {devices/res.sym} 1010 -590 0 0 {name=RSUB1
value=0.01
device=resistor}
C {devices/gnd.sym} 1010 -560 0 0 {name=l3 lab=GND}
C {devices/lab_pin.sym} 830 -1060 0 1 {name=p8 sig_type=std_logic lab=inp}
C {devices/vcvs.sym} 1690 -780 0 1 {name=Evdrv value=1.0}
C {devices/lab_pin.sym} 1050 -810 0 0 {name=p9 sig_type=std_logic lab=inm}
C {devices/code_shown.sym} -1340 -340 0 0 {name=CONTROL only_toplevel=false value=".control
* Step function applied at time 100ns, measure slew from transient data
tran 100n 10u
meas tran thigh when V(out)= CACE[CACE\{Vvdd\} - 0.5] CROSS=LAST
meas tran tlow when V(out)=0.5 CROSS=LAST
let vres = 2.0 / ($&tlow - $&thigh)
* vres2 is the full-power bandwidth (fpbw)
let vres2 = $&vres / (3.1415926 * CACE\{Vvdd\})

echo $&vres $&vres2 > CACE\{simpath\}/CACE\{filename\}_CACE\{N\}.data
quit
.endc
"}
